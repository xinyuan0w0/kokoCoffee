<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="NlogRecords.log">

	<targets>
		<!-- 控制台输出 -->
		<target name="log_console" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="true" layout="[${time:format=HH\:mm\:ss}][${callsite:className=false:includeSourcePath=false}/${level}]: ${message} ${onexception:${newline} ${exception}}">
			<highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray" />
			<highlight-row condition="level == LogLevel.Debug" foregroundColor="Gray" />
			<highlight-row condition="level == LogLevel.Info" foregroundColor="White" />
			<highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
			<highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
			<highlight-row condition="level == LogLevel.Fatal" foregroundColor="Magenta" backgroundColor="White" />
		</target>
		<!-- 文件输出 -->
		<target name="log_file" xsi:type="File" fileName="${basedir}/kokoBot/Logs/${shortdate}.log" layout="[${time}][${callsite:className=true:fileName=true:includeSourcePath=false:methodName=true}/${level}]: ${message} ${onexception:${newline} ${exception:format=tostring} ${newline} ${stacktrace} ${newline}}" />
	</targets>

	<rules>
		<!-- 跳过所有级别的Microsoft组件的日志记录 -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<!-- 控制台输出所有级别的日志 -->
		<logger name="*" minlevel="Trace" writeTo="log_console" />
		<!-- 文件输出Debug及以上级别的日志 -->
		<logger name="*" minlevel="Debug" writeTo="log_file" />
	</rules>
</nlog>